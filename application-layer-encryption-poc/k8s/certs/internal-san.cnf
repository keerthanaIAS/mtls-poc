[ req ]
prompt = no
distinguished_name = dn
req_extensions = v3_req

[ dn ]
CN = internal-service

[ v3_req ]
subjectAltName = @alt_names
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[ alt_names ]
DNS.1 = internal-service
DNS.2 = internal-service.application-layer-encryption
DNS.3 = internal-service.application-layer-encryption.svc
DNS.4 = internal-service.application-layer-encryption.svc.cluster.local
