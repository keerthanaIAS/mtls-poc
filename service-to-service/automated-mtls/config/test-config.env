# Existing service-to-service POC directory
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
AUTOMATION_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Docker services
DOCKER_ROOT="mtls-root-ms-docker"
DOCKER_TRANSACTION="mtls-transaction-ms-docker"
DOCKER_ROOT_URL="http://localhost:3201"

# Podman services
PODMAN_ROOT="mtls-root-ms-podman"
PODMAN_TRANSACTION="mtls-transaction-ms-podman"
PODMAN_ROOT_URL="http://localhost:3101"

# Service-to-service endpoints
ROOT_ENDPOINT="/call-transaction"
TRANSACTION_ENDPOINT="/api/transaction"
EXPECTED_CLIENT_CN="root-ms"

# Existing root-ms certificate files
ROOT_CERT_DIR="$PROJECT_DIR/podman-runtime/certs/root-ms"
CLIENT_CERT="$ROOT_CERT_DIR/tls.crt"
CLIENT_KEY="$ROOT_CERT_DIR/tls.key"
CA_CERT="$ROOT_CERT_DIR/ca.crt"

# Load-test settings
LOAD_REQUESTS=1000
LOAD_CONCURRENCIES="10 50 100"
CURL_TIMEOUT=10

# Test output
RESULTS_DIR="$AUTOMATION_DIR/results"
STATUS_FILE="$RESULTS_DIR/status.csv"
LOAD_RESULTS="$RESULTS_DIR/load-results.csv"
RESOURCE_RESULTS="$RESULTS_DIR/resource-usage.txt"
